#version 430

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba32f, binding = 0) uniform image2D outputImage;

layout(std430, binding = 0) buffer Models { mat4 modelMatrices[]; };
layout(std430, binding = 1) buffer InvModels { mat4 inverseModelMatrices[]; };
layout(std430, binding = 2) buffer Materials { vec4 materialData[]; };
layout(std430, binding = 3) buffer BVH { vec4 bvhNodes[]; };

uniform vec3 cameraPosition;
uniform mat4 inverseViewMatrix;
uniform float fieldOfView;

const float EPS = 1e-4;
const int MAX_RAY_BOUNCES = 1;
const vec3 LIGHT_DIR = normalize(vec3(-0.5, -1.0, -0.4));
const vec3 LIGHT_COLOR = vec3(1.0, 1.0, 1.0);

// ------------------------------------------------------------
// Estructura de impacto
struct RayHit {
    bool didHit;
    float distance;
    vec3 position;
    vec3 normal;
    vec3 color;
    float reflectivity;
};

// ------------------------------------------------------------
// Intersección con AABB
bool intersectAxisAlignedBox(vec3 ro, vec3 rd,
                             vec3 boxMin, vec3 boxMax,
                             out float tN, out float tF)
{
    vec3 t0 = (boxMin - ro) / rd;
    vec3 t1 = (boxMax - ro) / rd;
    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);
    tN = max(max(tmin.x, tmin.y), tmin.z);
    tF = min(min(tmax.x, tmax.y), tmax.z);
    return tF >= max(tN, 0.0);
}

// ------------------------------------------------------------
// Intersección con caja orientada (OBB)
bool intersectOrientedBox(int idx, vec3 roW, vec3 rdW,
                          out float tHit, out vec3 pHit, out vec3 nHit)
{
    mat4 invM = inverseModelMatrices[idx];
    // 🔧 fallback si la inversa no está cargada
    if (invM[3][3] == 0.0)
        invM = inverse(modelMatrices[idx]);

    vec3 roL = (invM * vec4(roW, 1.0)).xyz;
    vec3 rdL = normalize((invM * vec4(rdW, 0.0)).xyz);

    float tN, tF;
    if (!intersectAxisAlignedBox(roL, rdL, vec3(-1.0), vec3(1.0), tN, tF))
        return false;

    float tLocal = (tN > EPS) ? tN : tF;
    vec3 hitLocal = roL + rdL * tLocal;

    vec3 distPos = abs(hitLocal - vec3(1.0));
    vec3 distNeg = abs(hitLocal + vec3(1.0));
    vec3 minDist = min(distPos, distNeg);
    float close = min(min(minDist.x, minDist.y), minDist.z);

    vec3 nLocal = vec3(0.0);
    if (minDist.x == close) nLocal = vec3(sign(hitLocal.x), 0, 0);
    else if (minDist.y == close) nLocal = vec3(0, sign(hitLocal.y), 0);
    else nLocal = vec3(0, 0, sign(hitLocal.z));

    mat4 M = modelMatrices[idx];
    mat3 N = transpose(inverse(mat3(M)));
    nHit = normalize(N * nLocal);
    pHit = (M * vec4(hitLocal, 1.0)).xyz;
    tHit = length(pHit - roW);
    return true;
}

// ------------------------------------------------------------
// Recorrido del "BVH" simplificado
RayHit traceScene(vec3 ro, vec3 rd)
{
    RayHit best;
    best.didHit = false;
    best.distance = 1e20;

    for (int i = 0; i < materialData.length(); i++) {
        float t; vec3 p; vec3 n;
        if (intersectOrientedBox(i, ro, rd, t, p, n)) {
            if (t < best.distance && t > EPS) {
                best.didHit = true;
                best.distance = t;
                best.position = p;
                best.normal = n;
                vec4 mat = materialData[i];
                best.color = mat.rgb;
                best.reflectivity = mat.a;
            }
        }
    }
    return best;
}

// ------------------------------------------------------------
// Sombra
float computeShadow(vec3 pos, vec3 normal)
{
    vec3 ro = pos + normal * EPS * 2.0;
    vec3 rd = -LIGHT_DIR;
    for (int i = 0; i < materialData.length(); i++) {
        float t; vec3 p; vec3 n;
        if (intersectOrientedBox(i, ro, rd, t, p, n))
            return 0.3; // en sombra
    }
    return 1.0;
}

// ------------------------------------------------------------
// Color del cielo
vec3 skyColor(vec3 rd)
{
    float t = 0.5 * (rd.y + 1.0);
    return mix(vec3(0.6, 0.8, 1.0), vec3(0.05, 0.1, 0.2), t);
}

// ------------------------------------------------------------
// Shading iterativo (sin recursión)
vec3 shadeIterative(vec3 ro, vec3 rd)
{
    vec3 color = vec3(0.0);
    vec3 mask = vec3(1.0);

    for (int bounce = 0; bounce <= MAX_RAY_BOUNCES; bounce++) {
        RayHit hit = traceScene(ro, rd);
        if (!hit.didHit) {
            color += mask * skyColor(rd);
            break;
        }

        float diff = max(dot(hit.normal, -LIGHT_DIR), 0.0);
        float shadow = computeShadow(hit.position, hit.normal);
        vec3 diffuse = diff * hit.color * LIGHT_COLOR * shadow;
        vec3 ambient = 0.15 * hit.color;
        color += mask * (diffuse + ambient);

        if (bounce < MAX_RAY_BOUNCES && hit.reflectivity > 0.0) {
            mask *= hit.reflectivity;
            ro = hit.position + hit.normal * EPS * 2.0;
            rd = reflect(rd, hit.normal);
        } else {
            break;
        }
    }
    return color;
}

// ------------------------------------------------------------
// MAIN
void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 res = imageSize(outputImage);
    if (pix.x >= res.x || pix.y >= res.y) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(res);
    vec2 ndc = uv * 2.0 - 1.0;

    float fovAdj = tan(radians(fieldOfView) * 0.5);
    float aspect = float(res.x) / float(res.y);
    ndc.x *= aspect * fovAdj;
    ndc.y *= fovAdj;

    vec3 rdCam = normalize(vec3(ndc, -1.0));
    vec3 rd = normalize((inverseViewMatrix * vec4(rdCam, 0.0)).xyz);
    vec3 ro = cameraPosition;

    vec3 finalColor = shadeIterative(ro, rd);
    imageStore(outputImage, pix, vec4(finalColor, 1.0));
}
